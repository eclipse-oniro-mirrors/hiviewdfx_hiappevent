import("//base/hiviewdfx/hiappevent/hiappevent.gni")
import("//build/config/features.gni")
import("//build/test.gni")
import("//build/ohos.gni")

module_output_path = "hiappevent/hiappevent"

ohos_fuzztest("CacheFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "$hiappevent_path/test/fuzztest/cache_fuzzer"

  sources = [
    "cache_fuzzer.cpp",
    "fuzz_api_stats_dao.cpp",
    "fuzz_app_event_dao.cpp",
    "fuzz_app_event_mapping_dao.cpp",
    "fuzz_app_event_observer_dao.cpp",
    "fuzz_app_event_store.cpp",
    "fuzz_custom_event_param_dao.cpp",
    "fuzz_user_id_dao.cpp",
    "fuzz_user_property_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/hiappevent_config.cpp",
    "$hiappevent_framework/native/libhiappevent/hiappevent_base.cpp",
    "$hiappevent_test_fuzz/init/appevent_store_init.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/api_stats_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/app_event_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/app_event_mapping_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/app_event_observer_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/app_event_store.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/custom_event_param_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/user_id_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/cache/user_property_dao.cpp",
    "$hiappevent_framework/native/libhiappevent/utility/app_event_stat.cpp",
    "$hiappevent_framework/native/libhiappevent/utility/event_json_util.cpp",
    "$hiappevent_framework/native/libhiappevent/utility/file_util.cpp",
    "$hiappevent_framework/native/libhiappevent/utility/sql_util.cpp",
    "$hiappevent_framework/native/libhiappevent/utility/time_util.cpp",
  ]

  defines = [ "FUZZ_TEST" ]

  cflags_cc = [ "--coverage" ]
  ldflags = [ "--coverage" ]

  include_dirs = [
    "$hiappevent_framework/native/libhiappevent/include",
    "$hiappevent_framework/native/libhiappevent/cache/include",
    "$hiappevent_framework/native/libhiappevent/cleaner/include",
    "$hiappevent_framework/native/libhiappevent/observer/include",
    "$hiappevent_framework/native/libhiappevent/policy/include",
    "$hiappevent_framework/native/libhiappevent/stat/include",
    "$hiappevent_framework/native/libhiappevent/utility/include",
    "$hiappevent_framework/native/libhiappevent/load/include",
    "$hiappevent_framework/native/libhiappevent",
    "$hiappevent_interfaces/native/inner_api/include",
    "$hiappevent_interfaces/native/kits/include",
    "$hiappevent_test_fuzz/init/",
  ]



  external_deps = [
    "ability_base:configuration",
    "ability_runtime:app_context",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "bundle_framework:appexecfwk_core_headers",
    "c_utils:utils",
    "ffrt:libffrt",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "hilog:libsandboxlog",
    "hisysevent:libhisysevent",
    "hitrace:libhitracechain",
    "icu:shared_icuuc",
    "init:libbegetutil",
    "ipc:ipc_core",
    "ipc:ipc_single",
    "jsoncpp:jsoncpp",
    "relational_store:native_rdb",
    "resource_management:global_resmgr",
    "samgr:samgr_proxy",
    "storage_service:storage_manager_acl",
    "storage_service:storage_manager_sa_proxy",
  ]

  part_name = "hiappevent"
  subsystem_name = "hiviewdfx"
}

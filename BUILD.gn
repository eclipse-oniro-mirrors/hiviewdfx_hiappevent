import("//base/hiviewdfx/hiappevent/hiappevent.gni")

group("hiappevent_targets") {
  deps = [
    "$hiappevent_path/frameworks/native/libhiappevent:libhiappevent_base",
    "$hiappevent_path/frameworks/native/ndk:hiappevent_ndk",
    "$hiappevent_path/frameworks/js/napi:hiappevent",
    "$hiappevent_path/frameworks/js/napi:hiappevent_v9",
    "$hiappevent_path/frameworks/cj/ffi:cj_hiappevent_ffi",
    "$hiappevent_path/frameworks/ets/ani:ani_hiappevent_package",
    "$hiappevent_path/interfaces/native/inner_api:hiappevent_innerapi",
  ]
}

group("hiappevent_tests") {
  testonly = true
  deps = [
    "$hiappevent_path/test:fuzztest",
    "$hiappevent_path/test:unittest",
  ]
}
